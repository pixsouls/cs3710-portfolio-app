<p style="color: green"><%= notice %></p>

<h1>Students</h1>

<div id="students">
  <%= link_to "New student", new_student_path, class: "btn btn-success text-light" %>
  <table class="table table-striped">
    <tr>
      <th>First Name</th>
      <th class="one">Last Name</th>
      <th>Email</th>
      <th>Major</th>
      <th class="one">Minor</th>
      <th>Graduation Date</th>
      <th>Actions</th>
    </tr>
    <% @students.each do |student| %>
      <tr>
        <%= render student %>
        <td>
          <%= link_to "Show", student, class: "btn purple text-light", role:'button' %>
          <%= link_to "Edit", edit_student_path(student), class: "btn pink text-light", role:'button' %>
          <%= link_to "Delete", delete_student_path(student), class: "btn btn-danger text-light", role:'button' %>
        </td>
      </tr>
    <% end %>
  </table>
  <% if @message %>
    <h2 class="light-text"><%= @message %></h2>
  <% end %>
</div>

<style>
  .indigo {
    background-color: #6610f2;
  }
  .purple {
    background-color: #6f42c1;
  }
  .pink {
    background-color: #d63384;
  }
  @media only screen and (max-width: 900px) {
    .one{
        display: none;
    }
  }
</style>
